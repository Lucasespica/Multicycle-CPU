-- =====================================================================
-- t3_desvios: BEQ, BNE, JMP e HALT.
-- Casos: desvio para tras (laco) tomado e nao tomado, BEQ para frente tomado
-- e nao tomado, JMP para frente e parada no HALT.
-- As instrucoes marcadas como PULADA escrevem em R3, R4 ou R7: se algum
-- desses registradores mudar, o desvio falhou.

WIDTH = 16;
DEPTH = 4096;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
    000 : 5203;   --       ADDI R1, R0, 3     R1 = 3, contador do laco
    001 : 5400;   --       ADDI R2, R0, 0     R2 = 0, acumulador
    002 : 5482;   -- laco: ADDI R2, R2, 2     R2 += 2
    003 : 527F;   --       ADDI R1, R1, -1    R1 -= 1
    004 : 923D;   --       BNE  R1, R0, laco  para tras: tomado 2 vezes, nao tomado 1 vez
    005 : 8201;   --       BEQ  R1, R0, pula  para frente, tomado (R1 = 0)
    006 : 5601;   --       ADDI R3, R0, 1     PULADA
    007 : 8402;   -- pula: BEQ  R2, R0, erro  nao tomado (R2 = 6)
    008 : A00C;   --       JMP  fim           salto para frente
    009 : 5801;   --       ADDI R4, R0, 1     PULADA
    00A : 5E3F;   -- erro: ADDI R7, R0, -1    so executa se algum desvio falhar
    00B : F000;   --       HALT               parada de erro
    00C : 5A05;   -- fim:  ADDI R5, R0, 5     R5 = 5
    00D : F000;   --       HALT               fim
    [00E..FFF] : F000;   -- HALT (o resto da memoria)
END;
