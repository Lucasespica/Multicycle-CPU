        <!-- legenda -->
        <mxCell id="leg" value="Máquina de Moore. Toda transição acontece só na borda de subida com en = 1; rst (assíncrono) leva a BUSCA.&lt;br&gt;Condições = opcode (RI[15:12]). Setas verdes: fim da instrução, volta para BUSCA. HALT só sai com reset (KEY3)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
